# Copy to .env and fill in values from YOUR Coarena account.
# Never put this file in the browser bundle or in localStorage.

# Required. Real key from https://coarena.ai/account/api/keys (scope inference:write).
COARENA_API_KEY=

# Required. OpenAI-compatible Model API base URL from https://coarena.ai/docs.
COARENA_BASE_URL=https://coarena.ai/api/v1

# Local bind: 127.0.0.1 for desktop use; 0.0.0.0 ONLY behind a TLS reverse proxy.
APP_HOST=127.0.0.1
APP_PORT=8787
APP_STATIC_DIR=

# Dev only: exact browser origin of the Vite server. Leave empty for same-origin builds.
# APP_ALLOWED_ORIGIN=http://localhost:5173

# Optional shared secret when the simulator is reachable from other machines.
# APP_ACCESS_TOKEN=

# Documented Coarena limits: 30 requests/minute per key and 2 concurrent calls.
COARENA_KEY_RPM=30
COARENA_MAX_CONCURRENCY=2

# Local abuse guard for this proxy (per client IP, per minute).
APP_CLIENT_RPM=20

# Upstream call timeout; long answers are padded by Coarena after 20 s.
COARENA_TIMEOUT_MS=180000
COARENA_MAX_ATTEMPTS=4
COARENA_BACKOFF_BASE_MS=400
COARENA_BACKOFF_MAX_MS=8000

# Live model list reuse (the list itself is always fetched, never hardcoded).
MODEL_CACHE_TTL_MS=600000
